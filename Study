<script>
// ===================== NAVIGATION =====================
function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const idx = ['home','guide-core1','guide-core2','memory','cheatsheet','exam'].indexOf(id);
  if(idx >= 0) document.querySelectorAll('.nav-tab')[idx].classList.add('active');
  window.scrollTo(0,0);
}

function scrollToAnchor(id) {
  document.getElementById(id)?.scrollIntoView({behavior:'smooth', block:'start'});
}

// ===================== EXAM STATE =====================
let currentExamType = 'core1';
let currentVersion = 1;
let currentQuestions = [];
let userAnswers = {};
let examStarted = false;

function setExamType(type) {
  currentExamType = type;
  document.querySelectorAll('.exam-type-btn').forEach(b => b.classList.remove('active'));
  event.target.classList.add('active');
  loadExam(currentVersion);
}

function loadExam(version) {
  currentVersion = version;
  document.querySelectorAll('.version-btn').forEach((b,i) => b.classList.toggle('active', i===version-1));
  userAnswers = {};
  examStarted = false;
  currentQuestions = getQuestions(currentExamType, version);
  renderExam();
}

function startExam() {
  userAnswers = {};
  examStarted = true;
  currentQuestions = getQuestions(currentExamType, currentVersion);
  renderExam();
}

// ===================== RENDER EXAM =====================
function renderExam() {
  const area = document.getElementById('exam-area');
  const qs = currentQuestions;
  const answered = Object.keys(userAnswers).length;
  const correct = Object.keys(userAnswers).filter(k => userAnswers[k] === qs[k].answer).length;
  const pct = answered > 0 ? Math.round((correct/answered)*100) : 0;

  let html = `
    <div class="exam-header-bar">
      <div class="exam-progress">
        <div class="exam-progress-label">
          <span>Progress: ${answered}/${qs.length} answered</span>
          <span>${correct} correct</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" style="width:${(answered/qs.length)*100}%"></div></div>
      </div>
      <div class="exam-score">${answered>0?pct+'%':'—'}<br><span>Score</span></div>
    </div>`;

  qs.forEach((q, i) => {
    const answered = userAnswers[i] !== undefined;
    const isCorrect = userAnswers[i] === q.answer;
    html += `<div class="question-card" id="qcard-${i}">
      <div class="q-header">
        <div class="q-num">${i+1}</div>
        <div>
          <div class="q-domain">${q.domain}</div>
          <div class="q-text">${q.q}</div>
        </div>
      </div>
      <div class="q-options">`;

    q.options.forEach((opt, oi) => {
      let cls = 'q-option';
      if(answered) {
        if(oi === q.answer) cls += ' correct';
        else if(oi === userAnswers[i]) cls += ' incorrect';
      } else if(userAnswers[i] === oi) cls += ' selected';
      html += `<div class="${cls}" onclick="${answered?'':'selectAnswer('+i+','+oi+')'}">
        <span class="opt-letter">${'ABCD'[oi]}</span>
        <span>${opt}</span>
      </div>`;
    });

    html += `</div>
      <button class="q-submit ${userAnswers[i]!==undefined&&!answered?'visible':''}" id="submit-${i}" onclick="submitAnswer(${i})">Check Answer</button>
      <div class="q-explanation ${answered?'visible':''}" id="exp-${i}">
        <strong>✓ Correct Answer: ${'ABCD'[q.answer]}</strong><br>${q.explanation}
      </div>
    </div>`;
  });

  const allAnswered = Object.keys(userAnswers).length === qs.length;
  if(allAnswered) {
    const finalPct = Math.round((Object.keys(userAnswers).filter(k=>userAnswers[k]===qs[k].answer).length/qs.length)*100);
    const pass = finalPct >= (currentExamType==='core1'?75:78);
    html += `<div class="results-card">
      <div class="results-score ${pass?'pass':'fail'}">${finalPct}%</div>
      <div class="results-label">${pass?'🎉 PASS — Great Work!':'📚 Keep Studying'}</div>
      <div class="results-sub">${pass?'You\'re on track to pass the real exam!':'Review the explanations and try again. Aim for 80%+'}</div>
      <div class="results-breakdown">
        <div class="breakdown-item"><div class="breakdown-label">Correct</div><div class="breakdown-val" style="color:var(--accent3)">${Object.keys(userAnswers).filter(k=>userAnswers[k]===qs[k].answer).length}</div></div>
        <div class="breakdown-item"><div class="breakdown-label">Incorrect</div><div class="breakdown-val" style="color:var(--danger)">${qs.length-Object.keys(userAnswers).filter(k=>userAnswers[k]===qs[k].answer).length}</div></div>
        <div class="breakdown-item"><div class="breakdown-label">Total</div><div class="breakdown-val">${qs.length}</div></div>
      </div>
      <button class="restart-btn" onclick="startExam()">🔄 Retake This Version</button>
      <button class="restart-btn" onclick="loadExam(currentVersion===3?1:currentVersion+1)">➡️ Try Next Version</button>
    </div>`;
  }

  area.innerHTML = html;
}

function selectAnswer(qi, oi) {
  // Store selection but don't submit yet
  const qs = currentQuestions;
  // Mark as pending selection
  document.querySelectorAll(`#qcard-${qi} .q-option`).forEach((el,i)=>{
    el.classList.toggle('selected', i===oi);
  });
  // Show submit button
  const btn = document.getElementById(`submit-${qi}`);
  if(btn) { btn.classList.add('visible'); btn.onclick = ()=>confirmAnswer(qi,oi); }
}

function confirmAnswer(qi, oi) {
  userAnswers[qi] = oi;
  const qs = currentQuestions;
  // Update UI for this question
  const card = document.getElementById(`qcard-${qi}`);
  card.querySelectorAll('.q-option').forEach((el,i)=>{
    el.classList.remove('selected');
    if(i===qs[qi].answer) el.classList.add('correct');
    else if(i===oi) el.classList.add('incorrect');
    el.onclick = null;
  });
  const btn = document.getElementById(`submit-${qi}`);
  if(btn) btn.classList.remove('visible');
  const exp = document.getElementById(`exp-${qi}`);
  if(exp) exp.classList.add('visible');

  // Update header bar
  const answered = Object.keys(userAnswers).length;
  const correct = Object.keys(userAnswers).filter(k=>userAnswers[k]===qs[k].answer).length;
  const pct = Math.round((correct/answered)*100);
  const scoreEl = document.querySelector('.exam-score');
  if(scoreEl) scoreEl.innerHTML = `${pct}%<br><span>Score</span>`;
  const fillEl = document.querySelector('.progress-fill');
  if(fillEl) fillEl.style.width = `${(answered/qs.length)*100}%`;
  const progLabel = document.querySelector('.exam-progress-label');
  if(progLabel) progLabel.innerHTML = `<span>Progress: ${answered}/${qs.length} answered</span><span>${correct} correct</span>`;

  // Check if all answered — show results
  if(answered === qs.length) {
    setTimeout(renderExam, 300);
  }
}

