<section id="guide-core1" class="section">
  <div style="margin-bottom:24px;">
    <div class="hero-badge">220-1101 STUDY GUIDE</div>
    <h1 style="font-family:var(--sans);font-size:36px;font-weight:800;margin:12px 0;background:linear-gradient(135deg,#fff,var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Core 1: Hardware & Networking</h1>
    <p style="color:var(--text-dim);">Domain breakdown: Mobile Devices 15% • Networking 20% • Hardware 25% • Virtualization & Cloud 11% • Hardware Troubleshooting 29%</p>
  </div>

  <div class="guide-grid">
    <div class="guide-sidebar">
      <h3>Domains</h3>
      <div class="sidebar-item active" onclick="scrollToAnchor('c1-mobile')"><span class="sidebar-dot"></span>1. Mobile Devices</div>
      <div class="sidebar-item" onclick="scrollToAnchor('c1-networking')"><span class="sidebar-dot"></span>2. Networking</div>
