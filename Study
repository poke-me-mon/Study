function getCore2Questions(v) {
  const all = [
  // OPERATING SYSTEMS
  {domain:'💻 Operating Systems',q:'Which Windows edition is required to join a computer to an Active Directory domain?',options:['Windows Home','Windows Pro','Windows SE','Any edition supports domain join'],answer:1,explanation:'Windows Home edition does NOT support joining an Active Directory domain. Windows Pro, Enterprise, and Education editions support domain join and Group Policy management.'},
  {domain:'💻 Operating Systems',q:'Which command repairs corrupted Windows system files?',options:['chkdsk /f','sfc /scannow','DISM /RestoreHealth','diskpart /repair'],answer:1,explanation:'sfc /scannow (System File Checker) scans and repairs corrupted or missing Windows system files. If sfc fails, run DISM /online /cleanup-image /RestoreHealth first, then retry sfc.'},
  {domain:'💻 Operating Systems',q:'A user's computer shows a blinking cursor on a black screen and never boots into Windows. What tool should be tried FIRST?',options:['System Restore','Format and reinstall','Startup Repair','sfc /scannow'],answer:2,explanation:'Startup Repair (available from Windows Recovery Environment) automatically diagnoses and fixes common boot problems like missing bootloader files, corrupted BCD, and similar issues.'},
  {domain:'💻 Operating Systems',q:'Which file system supports file-level permissions, encryption (EFS), and is required for BitLocker to work?',options:['FAT32','exFAT','NTFS','ReFS'],answer:2,explanation:'NTFS (New Technology File System) supports permissions, EFS encryption, compression, disk quotas, and journaling. BitLocker requires an NTFS-formatted system partition.'},
  {domain:'💻 Operating Systems',q:'What is the maximum file size supported by the FAT32 file system?',options:['2 GB','4 GB','16 GB','No limit'],answer:1,explanation:'FAT32 has a maximum individual file size of exactly 4 GB (4,294,967,295 bytes). Files larger than 4 GB cannot be stored on FAT32 volumes. exFAT removes this limitation.'},
  {domain:'💻 Operating Systems',q:'Which Windows utility boots with minimal drivers and is used to diagnose issues caused by bad drivers or malware?',options:['Windows Recovery Environment','Safe Mode','System Configuration','Device Manager'],answer:1,explanation:'Safe Mode loads Windows with a minimal set of drivers and services. It\'s ideal for diagnosing driver conflicts, removing malware that hides in normal mode, or accessing the system when normal boot fails.'},
  {domain:'💻 Operating Systems',q:'A user needs to prevent a specific program from running at startup. Which tool should be used in Windows 10?',options:['services.msc','msconfig','Task Manager → Startup tab','regedit'],answer:2,explanation:'In Windows 10 and 11, startup programs are managed in Task Manager under the Startup tab. You can enable/disable programs from running at startup. (Older Windows versions used msconfig.)'},
  {domain:'💻 Operating Systems',q:'Which run command opens Disk Management in Windows?',options:['diskmgmt.msc','diskpart','compmgmt.msc','devmgmt.msc'],answer:0,explanation:'diskmgmt.msc opens Disk Management, the GUI tool for creating, deleting, formatting partitions, changing drive letters, and initializing new disks.'},
  {domain:'💻 Operating Systems',q:'Which Windows feature provides full drive encryption using AES and requires a TPM chip?',options:['EFS','BitLocker','FileVault','Windows Hello'],answer:1,explanation:'BitLocker is Windows\'s full-disk encryption feature. It encrypts the entire drive using AES and can use a TPM (Trusted Platform Module) chip to store the encryption key, preventing unauthorized access.'},
  {domain:'💻 Operating Systems',q:'What does the NTFS permission "Modify" allow a user to do?',options:['Only read files','Read, write, and delete files but not change permissions','Full control including permission changes','Write only, no reading'],answer:1,explanation:'NTFS Modify permission allows reading, writing, and deleting files and folders. Full Control additionally allows changing permissions and taking ownership. Read only allows reading.'},
  {domain:'💻 Operating Systems',q:'A technician needs to access a command prompt before Windows loads. How should they access it?',options:['Task Manager → File → New Task','Safe Mode with Command Prompt','F8 → Command Prompt → WinRE','Recovery Drive or installation media → WinRE'],answer:3,explanation:'Windows Recovery Environment (WinRE) is accessible from installation media or a recovery drive before Windows loads. It provides Startup Repair, Command Prompt, and System Restore.'},
  {domain:'💻 Operating Systems',q:'Which macOS feature is equivalent to Windows BitLocker?',options:['Gatekeeper','XProtect','FileVault','Keychain'],answer:2,explanation:'FileVault is macOS\'s built-in full-disk encryption feature, equivalent to Windows BitLocker. It encrypts the entire macOS startup disk to protect data if the Mac is stolen.'},
  {domain:'💻 Operating Systems',q:'What does UAC (User Account Control) do in Windows?',options:['Manages user account passwords','Prompts for administrator approval before system changes','Restricts internet access for standard users','Monitors user activity'],answer:1,explanation:'UAC (User Account Control) helps prevent unauthorized changes by prompting for admin credentials (or confirmation) before allowing programs to make system-level changes. It is a key security feature.'},
  // SECURITY
  {domain:'🔒 Security',q:'Which type of malware encrypts user files and demands payment for the decryption key?',options:['Spyware','Ransomware','Adware','Rootkit'],answer:1,explanation:'Ransomware encrypts victim\'s files and demands payment (typically cryptocurrency) for the decryption key. Notable examples: WannaCry, CryptoLocker, REvil. Prevention: regular backups and patching.'},
  {domain:'🔒 Security',q:'A user receives an email that appears to be from their bank, asking them to click a link and verify their account. What type of attack is this?',options:['Vishing','Smishing','Phishing','Whaling'],answer:2,explanation:'Phishing uses fraudulent emails that impersonate trusted organizations to steal credentials. This is the most common form of social engineering. Vishing=voice, Smishing=SMS, Whaling=targeting executives.'},
  {domain:'🔒 Security',q:'Which authentication factor is "something you are"?',options:['Password','Smart card','PIN','Fingerprint'],answer:3,explanation:'Biometric factors (fingerprint, face recognition, iris scan, retina scan) are "something you are" — physical characteristics unique to you. Password and PIN are "something you know." Smart card is "something you have."'},
  {domain:'🔒 Security',q:'An attacker calls an employee pretending to be IT support and convinces them to reveal their password. What type of attack is this?',options:['Phishing','Vishing','Pretexting','Tailgating'],answer:2,explanation:'Pretexting involves creating a fabricated scenario (pretext) to manipulate someone into revealing information. The attacker created a false context (IT support) to extract the password. (Vishing specifically refers to voice/phone phishing.)'},
  {domain:'🔒 Security',q:'Which security feature uses a hardware chip to store encryption keys and verify system integrity at boot?',options:['UEFI Secure Boot','TPM (Trusted Platform Module)','BitLocker','Windows Hello'],answer:1,explanation:'TPM (Trusted Platform Module) is a hardware chip on the motherboard that securely stores cryptographic keys, certificates, and passwords. It enables BitLocker and verifies the boot process hasn\'t been tampered with.'},
  {domain:'🔒 Security',q:'A user notices their computer is running very slowly, sending lots of network traffic, and they didn\'t install any new software. What is the MOST likely cause?',options:['Failing hard drive','Outdated drivers','Malware infection','Insufficient RAM'],answer:2,explanation:'Slow performance + unexpected high network traffic + no user-initiated cause are classic malware symptoms — especially botnet activity where the infected machine sends spam, attacks others, or mines cryptocurrency.'},
  {domain:'🔒 Security',q:'Which wireless security standard is considered MOST secure?',options:['WEP','WPA','WPA2-TKIP','WPA3'],answer:3,explanation:'WPA3 is the newest and most secure wireless standard, using SAE (Simultaneous Authentication of Equals) which resists offline dictionary attacks. WEP is broken, WPA is deprecated, WPA2 is still acceptable.'},
  {domain:'🔒 Security',q:'What is the FIRST step in the CompTIA malware removal process?',options:['Run antivirus scan','Quarantine the system','Disable System Restore','Reformat the drive'],answer:1,explanation:'The first step is to quarantine (disconnect) the infected system from the network to prevent spread. Then disable System Restore, scan and remediate, re-enable System Restore, update, and educate user.'},
  {domain:'🔒 Security',q:'An attacker follows an authorized employee through a secure door without swiping their own badge. What is this called?',options:['Shoulder surfing','Piggybacking/Tailgating','Dumpster diving','Pretexting'],answer:1,explanation:'Tailgating (or piggybacking) is physically following an authorized person through a secure entry point without using your own credentials. It bypasses physical access controls.'},
  {domain:'🔒 Security',q:'Which principle states that users should be given only the minimum permissions necessary to do their job?',options:['Need-to-know','Least privilege','Separation of duties','Defense in depth'],answer:1,explanation:'The principle of least privilege (PoLP) limits user access rights to the minimum necessary to perform their job functions. This limits the damage that can be done if an account is compromised.'},
  {domain:'🔒 Security',q:'A user reports pop-ups appearing even when no browser is open, and the home page has changed. What is MOST likely installed?',options:['Ransomware','Rootkit','Adware/PUP','Keylogger'],answer:2,explanation:'Pop-ups outside the browser and a changed home page are classic symptoms of adware or PUP (Potentially Unwanted Program). These are usually installed bundled with free software.'},
  // SOFTWARE TROUBLESHOOTING
  {domain:'⚙️ Software Troubleshooting',q:'A Windows computer displays a BSOD (Blue Screen of Death) with the stop code "IRQL_NOT_LESS_OR_EQUAL." What is the MOST likely cause?',options:['Hard drive failure','Faulty or incompatible driver','Corrupt user profile','Virus infection'],answer:1,explanation:'IRQL errors typically indicate a driver accessing memory it shouldn\'t, usually a recently installed or updated driver. Check for new driver installations and roll them back if needed.'},
  {domain:'⚙️ Software Troubleshooting',q:'A user cannot log in because their profile is corrupt. What is the recommended solution?',options:['Reinstall Windows','Create a new user profile and copy files','Delete the user account','Run chkdsk'],answer:1,explanation:'The standard fix for a corrupt user profile is to create a new local user account, then copy the user\'s data files (Documents, Desktop, etc.) from the old profile folder to the new one.'},
  {domain:'⚙️ Software Troubleshooting',q:'After installing a new application, Windows shows an application compatibility error. What should be tried FIRST?',options:['Reinstall Windows','Use compatibility mode','Buy newer hardware','Contact the developer'],answer:1,explanation:'Windows compatibility mode allows older applications to run by emulating an older Windows version (e.g., Windows 7 or XP). Right-click the executable → Properties → Compatibility tab.'},
  {domain:'⚙️ Software Troubleshooting',q:'A computer running Windows 10 suddenly cannot boot and shows "Operating System not found." Which tool should be tried FIRST?',options:['Format and reinstall','sfc /scannow','Startup Repair from WinRE','DISM /RestoreHealth'],answer:2,explanation:'Startup Repair automatically diagnoses and fixes common boot issues like missing or corrupt bootloader files (BCD - Boot Configuration Data). It should be the first tool tried for boot failures.'},
  {domain:'⚙️ Software Troubleshooting',q:'Which Windows command-line tool can repair a corrupt Windows disk image when sfc fails?',options:['diskpart','chkdsk','DISM /online /cleanup-image /RestoreHealth','bcdedit'],answer:2,explanation:'DISM (Deployment Image Servicing and Management) can repair the local Windows image. Run DISM /online /cleanup-image /RestoreHealth before running sfc /scannow when system files are too corrupt for sfc to fix.'},
  {domain:'⚙️ Software Troubleshooting',q:'A user reports that their application frequently freezes but other applications work fine. What should the technician do FIRST?',options:['Reinstall Windows','Check for application updates and reinstall','Add more RAM','Run sfc /scannow'],answer:1,explanation:'When only one application has problems, the issue is likely with that application — a corrupt installation or bug. Check for updates (patches), and if that fails, uninstall and reinstall the application.'},
  // OPERATIONAL PROCEDURES
  {domain:'📋 Operational Procedures',q:'Which backup type backs up ALL data every time it runs?',options:['Incremental','Differential','Full','Synthetic'],answer:2,explanation:'A full backup copies all selected data every time. It is the most complete but also the most time-consuming and storage-intensive. Recovery requires only the most recent full backup.'},
  {domain:'📋 Operational Procedures',q:'A company performs a full backup on Sunday and incremental backups Monday–Saturday. On Thursday, they need to restore. Which backups are needed?',options:['Only Sunday\'s full backup','Sunday full + Monday + Tuesday + Wednesday incrementals','Sunday full + Wednesday incremental only','All backups'],answer:1,explanation:'Incremental backup restores require the full backup PLUS every incremental backup from the last full to the failure point. To restore Thursday: need Sunday + Mon + Tue + Wed incrementals (in order).'},
  {domain:'📋 Operational Procedures',q:'What does the 3-2-1 backup rule specify?',options:['3 full backups, 2 differential, 1 incremental','3 copies of data, 2 different media types, 1 offsite copy','3 servers, 2 networks, 1 cloud','3 daily backups, 2 weekly, 1 monthly'],answer:1,explanation:'The 3-2-1 backup rule: keep 3 copies of data, on 2 different types of storage media (e.g., HDD + tape), with 1 copy stored offsite. This protects against local disasters.'},
  {domain:'📋 Operational Procedures',q:'Which document defines what employees are and are not allowed to do with company IT resources?',options:['Service Level Agreement','Non-Disclosure Agreement','Acceptable Use Policy','Change Management Policy'],answer:2,explanation:'An Acceptable Use Policy (AUP) defines the acceptable ways employees may use company computers, networks, and internet. Violations may result in disciplinary action.'},
  {domain:'📋 Operational Procedures',q:'A technician needs to handle components that may be damaged by static electricity. What should be used?',options:['Rubber mat','Anti-static wrist strap','Cotton gloves','Grounding strap on the floor'],answer:1,explanation:'An ESD (Electrostatic Discharge) wrist strap connects the technician to ground, safely dissipating static charge. An ESD mat on the work surface provides additional protection.'},
  {domain:'📋 Operational Procedures',q:'Which term describes the maximum amount of time a business can tolerate a system being down?',options:['RPO (Recovery Point Objective)','RTO (Recovery Time Objective)','MTTR (Mean Time to Repair)','MTBF (Mean Time Between Failures)'],answer:1,explanation:'RTO (Recovery Time Objective) is the maximum tolerable downtime. RPO is the maximum acceptable data loss (how old can the restored data be?). Both are determined in the Business Continuity Plan.'},
  {domain:'📋 Operational Procedures',q:'How should old hard drives containing sensitive data be properly disposed of?',options:['Standard formatting','Quick format','Physical destruction or degaussing','Recycling without additional steps'],answer:2,explanation:'Standard formatting is NOT sufficient — data can be recovered. Proper disposal of drives containing sensitive data requires physical destruction (shredding), degaussing (magnetic erasure), or certified data sanitization.'},
  // More questions...
  {domain:'🔒 Security',q:'What type of attack involves sending unsolicited messages to Bluetooth devices?',options:['Bluejacking','Bluesnarfing','Bluebugging','Bluetooth bombing'],answer:0,explanation:'Bluejacking sends unsolicited messages to nearby Bluetooth devices. Bluesnarfing is more serious — it accesses/steals data from a Bluetooth device. Keep Bluetooth discoverable mode off in public.'},
  {domain:'💻 Operating Systems',q:'Which Linux/macOS command displays the current working directory?',options:['ls','pwd','cd','dir'],answer:1,explanation:'pwd (print working directory) displays the full path of the current directory in Linux and macOS. ls lists directory contents. cd changes directory. dir is the Windows equivalent of ls.'},
  {domain:'💻 Operating Systems',q:'What is the purpose of the Windows Registry?',options:['Stores user documents','Central database for Windows settings and configuration','Manages network connections','Backs up system files'],answer:1,explanation:'The Windows Registry is a hierarchical database that stores configuration settings for Windows OS, applications, hardware, and user preferences. It is edited with regedit.exe — changes can cause system instability.'},
  {domain:'🔒 Security',q:'A user reports that every website they visit now redirects to a different site. What has MOST likely been modified?',options:['Browser settings only','The hosts file or DNS settings','The Windows firewall','The network adapter driver'],answer:1,explanation:'DNS poisoning or modification of the hosts file (C:\\Windows\\System32\\drivers\\etc\\hosts) can redirect all web traffic to malicious sites. Malware commonly modifies the hosts file.'},
  {domain:'⚙️ Software Troubleshooting',q:'A Windows PC shows "Low disk space" warnings frequently. What should the technician do FIRST?',options:['Buy a larger hard drive','Run Disk Cleanup and remove temp files','Reinstall Windows','Increase RAM'],answer:1,explanation:'Before buying hardware, first run Disk Cleanup (cleanmgr.exe) to remove temporary files, cached files, and empty the Recycle Bin. Also check for and uninstall unused applications.'},
  {domain:'📋 Operational Procedures',q:'Which disposal method is MOST secure for a hard drive containing classified data?',options:['Full format','Overwrite 7 times with zeros','Physical destruction (shredding)','Degaussing then physical destruction'],answer:3,explanation:'For classified or highly sensitive data, the most secure disposal combines degaussing (magnetically erases data) with physical destruction (shredding). This ensures no data can ever be recovered.'},
  {domain:'🔒 Security',q:'Which of the following is a strong password practice?',options:['Use your name and birth year','Use 8-character passwords with only letters','Use passphrases of 14+ characters with mixed types','Change passwords every day'],answer:2,explanation:'NIST guidelines recommend long passphrases (14+ characters) with complexity (uppercase, lowercase, numbers, symbols). Length is the most important factor. Forced frequent changes lead to weak, predictable passwords.'},
  {domain:'💻 Operating Systems',q:'A user reports that their Windows clock resets every time the computer is powered off. What is MOST likely the cause?',options:['Incorrect time zone setting','Dead CMOS battery','Virus infection','Network time server issue'],answer:1,explanation:'The CMOS battery (CR2032 on the motherboard) maintains BIOS settings and the real-time clock when the PC is off. A dead CMOS battery causes the clock to reset to a default date/time on every boot.'},
  {domain:'📋 Operational Procedures',q:'Which type of license is tied to the specific hardware it was originally installed on?',options:['Volume','Retail','OEM','Subscription'],answer:2,explanation:'OEM (Original Equipment Manufacturer) licenses are tied to the hardware they shipped with and cannot be transferred to a new computer. Retail licenses can be transferred between machines.'},
  {domain:'🔒 Security',q:'A security camera feed should be protected from unauthorized access. Which principle BEST ensures only security personnel can view it?',options:['Encryption at rest','Least privilege access control','Network segmentation','Physical security'],answer:1,explanation:'The principle of least privilege ensures only those who need access (security personnel) are granted it. Applying this to the camera management system prevents unauthorized viewing.'},
  {domain:'⚙️ Software Troubleshooting',q:'A user can no longer log into Windows after a password change. They are sure the password is correct. What should be checked?',options:['Num Lock key status','BitLocker status','System Restore','BIOS settings'],answer:0,explanation:'Num Lock being on when entering a password at the login screen is a very common and embarrassing mistake — numbers become numbers and letter keys may be affected. Always check Caps Lock and Num Lock first.'},
  {domain:'💻 Operating Systems',q:'Which Windows command-line tool is used to manage disk partitions from the command prompt?',options:['fdisk','diskmgmt.msc','diskpart','format'],answer:2,explanation:'diskpart is the command-line disk partitioning tool in Windows. It allows creating, deleting, formatting partitions, assigning drive letters, and setting active partitions. diskmgmt.msc is the GUI version.'},
  {domain:'🔒 Security',q:'What is a "zero-day" vulnerability?',options:['A vulnerability patched the same day it is discovered','A vulnerability that has existed for years','A newly discovered vulnerability with no patch available','A vulnerability that only works on Day 0 of an OS install'],answer:2,explanation:'A zero-day vulnerability is one that has been discovered by attackers but for which no patch exists yet. The term refers to the fact that developers have had "zero days" to fix it.'},
  {domain:'📋 Operational Procedures',q:'A technician is working on a customer\'s computer and notices personal photos on the desktop. What should the technician do?',options:['Comment on the photos to make conversation','View the photos to ensure they are not malicious','Respect the user\'s privacy and focus on the task','Report the photos to management'],answer:2,explanation:'Privacy is a key professional responsibility. Technicians must respect customer privacy and not view, comment on, or access personal data beyond what is necessary to complete the repair task.'},
  {domain:'💻 Operating Systems',q:'Which command is used to check a disk for errors in Windows?',options:['sfc /scannow','chkdsk /f','DISM /RestoreHealth','defrag'],answer:1,explanation:'chkdsk (Check Disk) scans for and repairs file system errors and bad sectors. chkdsk /f fixes errors; chkdsk /r locates bad sectors. It may require a restart to run on the system drive.'},
  {domain:'🔒 Security',q:'Which of the following BEST describes multi-factor authentication (MFA)?',options:['Using a very strong password','Using two or more different types of authentication factors','Using the same password on multiple devices','Logging in from multiple devices simultaneously'],answer:1,explanation:'MFA requires two or more DIFFERENT types of authentication factors: something you know (password) + something you have (phone) + something you are (fingerprint). Using two passwords is NOT MFA.'},
  {domain:'⚙️ Software Troubleshooting',q:'A user reports that Windows Search is not returning results. What should be done FIRST?',options:['Reinstall Windows','Run the Search and Indexing troubleshooter','Reformat the drive','Run chkdsk'],answer:1,explanation:'Windows has a built-in Search and Indexing troubleshooter that can fix common search issues. It can be found in Settings → Troubleshoot or by searching "Troubleshoot" in the Start menu.'},
  {domain:'💻 Operating Systems',q:'What is the default file system for modern Windows installations?',options:['FAT32','exFAT','NTFS','ReFS'],answer:2,explanation:'NTFS (New Technology File System) is the default and required file system for Windows installations. It supports permissions, encryption, compression, large files, and journaling.'},
  {domain:'📋 Operational Procedures',q:'What should be the technician\'s approach when a customer becomes rude and upset?',options:['Respond with equal emotion','Immediately terminate the call','Remain professional, empathetic, and de-escalate','Ignore the customer\'s concerns'],answer:2,explanation:'Professionalism requires maintaining calm and empathy even when customers are rude. De-escalation techniques (active listening, acknowledging frustration) are expected. CompTIA explicitly tests on professional communication.'},
  {domain:'🔒 Security',q:'Which of the following is the BEST way to protect against ransomware?',options:['Antivirus only','Regular backups stored offline','Strong passwords only','Firewall only'],answer:1,explanation:'The best protection against ransomware is regular offline backups. If files are encrypted by ransomware, offline backups allow restoration without paying the ransom. Antivirus helps but is not sufficient alone.'},
  {domain:'💻 Operating Systems',q:'A technician wants to run a program as administrator without switching user accounts. What should they do?',options:['Use Task Scheduler','Right-click → Run as Administrator','Change user account type','Use Safe Mode'],answer:1,explanation:'Right-clicking an application and selecting "Run as Administrator" elevates privileges for that session. This triggers UAC and is useful for running installers or utilities requiring admin rights without switching accounts.'},
  {domain:'⚙️ Software Troubleshooting',q:'Which tool in Windows allows a technician to see which applications are running at startup and disable them?',options:['Services.msc','Task Manager → Startup','Msconfig → Boot','Regedit'],answer:1,explanation:'In Windows 10/11, Task Manager\'s Startup tab shows all startup applications and their performance impact. You can enable or disable them there. (msconfig is used for boot options and services, not startup apps in modern Windows.)'},
  {domain:'🔒 Security',q:'What does the principle of "defense in depth" mean?',options:['Using one very strong security control','Using physical security only','Layering multiple security controls to protect assets','Monitoring network traffic 24/7'],answer:2,explanation:'Defense in depth (layered security) uses multiple overlapping security controls — physical, technical, and administrative — so that if one layer fails, others still protect. No single point of failure.'},
  {domain:'📋 Operational Procedures',q:'A change request has been approved. Before implementing, what should be done?',options:['Implement immediately','Notify affected users and create a rollback plan','Back up the system and document current state','All of the above'],answer:3,explanation:'A complete change management process includes: notifying affected users, backing up the system, documenting current state, and creating a rollback plan — all before implementing. This minimizes risk.'},
  {domain:'💻 Operating Systems',q:'Which Windows feature allows system settings to be "rolled back" to a previous state after a problematic change?',options:['Backup and Restore','BitLocker','System Restore','Previous Versions'],answer:2,explanation:'System Restore creates snapshots (restore points) of Windows system state. If a driver installation or software update causes problems, you can roll back to a restore point before the change.'},
  {domain:'🔒 Security',q:'An employee receives a text message from their CEO asking them to urgently buy gift cards and send the codes. What type of attack is this?',options:['Phishing','Vishing','Smishing','Whaling'],answer:2,explanation:'Smishing is SMS (text message) phishing. This scenario also involves impersonating an executive, which is a whaling/spear-phishing technique. The answer is Smishing since it\'s via text message.'},
  {domain:'📋 Operational Procedures',q:'When should an incident report be filed?',options:['Only for major outages','Whenever a security incident occurs','Only when data is lost','Only when hardware fails'],answer:1,explanation:'An incident report should be filed whenever a security incident occurs — regardless of size. This creates documentation, helps identify patterns, and is often required for compliance and insurance purposes.'},
  {domain:'💻 Operating Systems',q:'Which macOS utility is used to partition and format drives?',options:['fdisk','Disk Utility','DiskPart','Storage Manager'],answer:1,explanation:'Disk Utility (found in Applications → Utilities) is the macOS graphical tool for managing disks — partitioning, formatting (APFS, HFS+, exFAT), verifying, and repairing disk errors.'},
  {domain:'⚙️ Software Troubleshooting',q:'Windows keeps a log of all system events. Which tool is used to view these logs?',options:['Task Manager','Performance Monitor','Event Viewer','System Information'],answer:2,explanation:'Event Viewer (eventvwr.msc) displays logs of all Windows system events including errors, warnings, information, and security events. It is the primary tool for diagnosing Windows issues.'},
  {domain:'🔒 Security',q:'What is the purpose of a physical privacy screen on a laptop?',options:['Prevents screen glare','Limits viewing angle to prevent shoulder surfing','Improves display color accuracy','Reduces power consumption'],answer:1,explanation:'A privacy screen filter limits the viewing angle of a display, making the screen appear dark or black from the sides. This prevents shoulder surfing in public spaces like coffee shops or airplanes.'},
  {domain:'📋 Operational Procedures',q:'What regulation restricts the use of hazardous substances like lead and mercury in electronic equipment?',options:['WEEE','RoHS','OSHA','EPA 3008'],answer:1,explanation:'RoHS (Restriction of Hazardous Substances) is a European Union directive that restricts the use of specific hazardous materials (lead, mercury, cadmium, hexavalent chromium, etc.) in electrical and electronic equipment.'},
  {domain:'💻 Operating Systems',q:'Which Windows edition supports Group Policy management, BitLocker, and Remote Desktop host functionality?',options:['Windows Home','Windows SE','Windows Pro','Windows Basic'],answer:2,explanation:'Windows Pro includes Group Policy Editor (gpedit.msc), BitLocker encryption, Remote Desktop hosting capability, and domain join. Windows Home lacks all of these enterprise features.'},
  {domain:'🔒 Security',q:'Which type of malware hides itself within the OS and gives attackers persistent administrative access?',options:['Worm','Spyware','Rootkit','Trojan'],answer:2,explanation:'A rootkit hides itself deep in the operating system (often modifying kernel components), making it very difficult to detect. It gives attackers persistent admin (root) access while remaining hidden from security tools.'},
  {domain:'⚙️ Software Troubleshooting',q:'A mobile device app keeps crashing immediately after launch. What should be done FIRST?',options:['Factory reset the phone','Clear the app\'s cache and data','Reinstall the OS','Buy a new phone'],answer:1,explanation:'Clearing the app\'s cache and data removes corrupted temporary files and resets the app to default state. This is the first step and often fixes crashing apps without needing to reinstall or reset.'},
  {domain:'📋 Operational Procedures',q:'A user forgets to mention they need the computer back by end of day when asking for a repair. When should this have been communicated?',options:['After the repair is done','Before starting the repair','It doesn\'t matter','Only if repair takes more than 4 hours'],answer:1,explanation:'Setting expectations is a key professionalism principle. Timeline, costs, and any constraints should be communicated BEFORE starting work so both parties have aligned expectations.'},
  {domain:'🔒 Security',q:'A network administrator discovers that an unauthorized wireless access point has been installed in the office. What type of threat is this?',options:['Evil twin','Rogue access point','War driving','Deauth attack'],answer:1,explanation:'A rogue access point is an unauthorized wireless AP connected to the network — either by an employee (for convenience) or an attacker (to intercept traffic). It bypasses network security controls.'},
  {domain:'💻 Operating Systems',q:'Which Linux command installs software packages on Debian/Ubuntu systems?',options:['yum install','dnf install','apt install','pacman -S'],answer:2,explanation:'apt (Advanced Package Tool) is the package manager for Debian-based Linux distributions including Ubuntu. yum/dnf is used on Red Hat/CentOS/Fedora. pacman is for Arch Linux.'},
  {domain:'📋 Operational Procedures',q:'What is the purpose of a Service Level Agreement (SLA)?',options:['Defines acceptable use of IT resources','Defines the expected level of service between provider and customer','Manages software licensing','Documents network topology'],answer:1,explanation:'An SLA (Service Level Agreement) is a contract between a service provider and customer that defines expected service levels — uptime guarantees, response times, support hours, and penalties for not meeting them.'},
  {domain:'🔒 Security',q:'Which of the following is an example of two-factor authentication?',options:['Password + security question','Fingerprint + retina scan','Password + authenticator app code','Long password + short password'],answer:2,explanation:'True 2FA requires factors from DIFFERENT categories. Password (something you know) + authenticator app code (something you have) = 2FA. Password + security question are both "something you know" = NOT 2FA.'},
  {domain:'⚙️ Software Troubleshooting',q:'A user reports that Windows is running slowly after startup, with high disk activity for 10+ minutes. What is the MOST likely cause?',options:['Virus','Hard drive failure','Windows Update or indexing processes completing in background','Insufficient RAM'],answer:2,explanation:'High disk activity after startup is normal — Windows completes updates, runs Superfetch/prefetch, indexing, and antivirus scans in the background. This typically settles after 10-15 minutes.'},
  {domain:'💻 Operating Systems',q:'Which command forces a Group Policy update immediately on a Windows workstation?',options:['gpresult /r','gpupdate /force','secedit /refreshpolicy','netsh policy refresh'],answer:1,explanation:'gpupdate /force immediately applies all Group Policy settings, both user and computer. gpresult /r displays the currently applied policies (Resultant Set of Policy).'},
  {domain:'🔒 Security',q:'What does the acronym PII stand for?',options:['Public Internet Information','Personally Identifiable Information','Personal Infrastructure Interface','Protected Internet Identity'],answer:1,explanation:'PII (Personally Identifiable Information) is any information that can identify a specific individual — name, address, SSN, email, phone number, etc. Protecting PII is a legal and ethical obligation.'},
