<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CompTIA A+ Master Guide — Core 1 & Core 2</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0e1a;
    --surface: #111827;
    --surface2: #1a2235;
    --border: #1e2d47;
    --accent: #00d4ff;
    --accent2: #7c3aed;
    --accent3: #10b981;
    --warn: #f59e0b;
    --danger: #ef4444;
    --text: #e2e8f0;
    --text-dim: #94a3b8;
    --text-faint: #475569;
    --mono: 'Space Mono', monospace;
    --sans: 'Syne', sans-serif;
    --body: 'Inter', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* HEADER */
  .header {
    background: linear-gradient(135deg, #0a0e1a 0%, #0d1b2a 50%, #0a0e1a 100%);
    border-bottom: 1px solid var(--border);
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 64px;
  }

  .logo {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 2px;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .logo span { color: var(--text-dim); }

  .nav-tabs {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    flex: 1;
    scrollbar-width: none;
  }

  .nav-tabs::-webkit-scrollbar { display: none; }

  .nav-tab {
    background: none;
    border: none;
    color: var(--text-dim);
    font-family: var(--body);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
  }

  .nav-tab:hover { background: var(--surface2); color: var(--text); }
  .nav-tab.active { background: var(--accent); color: #000; font-weight: 600; }

  /* MAIN */
  .main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px;
  }

  /* SECTIONS */
  .section { display: none; }
  .section.active { display: block; }

  /* HERO */
  .hero {
    text-align: center;
    padding: 60px 0 40px;
    position: relative;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 2px;
    margin-bottom: 20px;
  }

  .hero h1 {
    font-family: var(--sans);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 16px;
    background: linear-gradient(135deg, #fff 0%, var(--accent) 50%, var(--accent2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero p {
    color: var(--text-dim);
    font-size: 18px;
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.7;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat-num {
    font-family: var(--mono);
    font-size: 32px;
    color: var(--accent);
    display: block;
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* EXAM SELECTOR */
  .exam-selector {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 40px 0;
  }

  .exam-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    cursor: pointer;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .exam-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
  }

  .exam-card.core1::before { background: linear-gradient(90deg, var(--accent), var(--accent2)); }
  .exam-card.core2::before { background: linear-gradient(90deg, var(--accent3), var(--warn)); }

  .exam-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .exam-card.selected { border-color: var(--accent); background: var(--surface2); }

  .exam-card h3 {
    font-family: var(--sans);
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .exam-card p { color: var(--text-dim); font-size: 14px; line-height: 1.6; }

  .exam-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 12px;
  }

  .core1-tag { background: rgba(0,212,255,0.1); color: var(--accent); }
  .core2-tag { background: rgba(16,185,129,0.1); color: var(--accent3); }

  /* STUDY GUIDE */
  .guide-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    align-items: start;
  }

  .guide-sidebar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .guide-sidebar h3 {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    color: var(--text-dim);
    transition: all 0.2s;
    margin-bottom: 2px;
  }

  .sidebar-item:hover { background: var(--surface2); color: var(--text); }
  .sidebar-item.active { background: rgba(0,212,255,0.1); color: var(--accent); }

  .sidebar-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--text-faint);
    flex-shrink: 0;
  }

  .sidebar-item.active .sidebar-dot { background: var(--accent); }

  .guide-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* CONTENT CARDS */
  .content-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
  }

  .content-card h2 {
    font-family: var(--sans);
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-icon {
    width: 36px; height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .icon-blue { background: rgba(0,212,255,0.1); }
  .icon-purple { background: rgba(124,58,237,0.1); }
  .icon-green { background: rgba(16,185,129,0.1); }
  .icon-yellow { background: rgba(245,158,11,0.1); }

  .content-card h3 {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--accent);
    margin: 24px 0 12px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }

  .content-card p {
    color: var(--text-dim);
    line-height: 1.8;
    margin-bottom: 12px;
    font-size: 14px;
  }

  /* MUST KNOW */
  .must-know {
    background: rgba(245,158,11,0.08);
    border: 1px solid rgba(245,158,11,0.3);
    border-left: 4px solid var(--warn);
    border-radius: 0 8px 8px 0;
    padding: 16px 20px;
    margin: 16px 0;
  }

  .must-know-header {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--warn);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .must-know p { color: var(--text); font-size: 14px; margin-bottom: 6px; }
  .must-know p:last-child { margin-bottom: 0; }

  /* KEY TERM */
  .term {
    display: inline-block;
    background: rgba(124,58,237,0.15);
    border: 1px solid rgba(124,58,237,0.3);
    color: #a78bfa;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 12px;
    margin: 2px;
  }

  /* TABLE */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 13px;
  }

  .data-table th {
    background: var(--surface2);
    color: var(--text-dim);
    font-weight: 600;
    text-align: left;
    padding: 10px 14px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border);
  }

  .data-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
    vertical-align: top;
    line-height: 1.6;
  }

  .data-table tr:hover td { background: var(--surface2); color: var(--text); }

  .data-table td:first-child {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: bold;
    white-space: nowrap;
  }

  /* MNEMONIC */
  .mnemonic {
    background: rgba(16,185,129,0.08);
    border: 1px solid rgba(16,185,129,0.2);
    border-radius: 10px;
    padding: 20px;
    margin: 16px 0;
  }

  .mnemonic-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent3);
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .mnemonic-word {
    font-family: var(--sans);
    font-size: 22px;
    font-weight: 800;
    color: var(--accent3);
    margin-bottom: 8px;
  }

  .mnemonic p { font-size: 14px; color: var(--text-dim); }
  .mnemonic strong { color: var(--text); }

  /* PRACTICE EXAM */
  .exam-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .exam-version-btns {
    display: flex;
    gap: 8px;
  }

  .version-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 12px;
    padding: 8px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .version-btn:hover { border-color: var(--accent); color: var(--text); }
  .version-btn.active { background: var(--accent); border-color: var(--accent); color: #000; font-weight: 700; }

  .exam-header-bar {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .exam-progress {
    flex: 1;
    min-width: 200px;
  }

  .exam-progress-label {
    font-size: 12px;
    color: var(--text-dim);
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
  }

  .progress-bar {
    height: 6px;
    background: var(--border);
    border-radius: 3px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    border-radius: 3px;
    transition: width 0.3s;
  }

  .exam-score {
    font-family: var(--mono);
    font-size: 28px;
    color: var(--accent);
    text-align: right;
  }

  .exam-score span { font-size: 14px; color: var(--text-dim); }

  /* QUESTION */
  .question-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    margin-bottom: 16px;
  }

  .q-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
  }

  .q-num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
    background: var(--surface2);
    border: 1px solid var(--border);
    width: 36px; height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 700;
  }

  .q-domain {
    font-size: 11px;
    color: var(--text-faint);
    font-family: var(--mono);
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .q-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text);
    font-weight: 500;
  }

  .q-options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .q-option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 14px;
    color: var(--text-dim);
    background: var(--bg);
  }

  .q-option:hover { border-color: var(--accent); color: var(--text); background: rgba(0,212,255,0.03); }

  .q-option.selected { border-color: var(--accent); background: rgba(0,212,255,0.08); color: var(--text); }
  .q-option.correct { border-color: var(--accent3); background: rgba(16,185,129,0.1); color: #6ee7b7; }
  .q-option.incorrect { border-color: var(--danger); background: rgba(239,68,68,0.08); color: #fca5a5; }

  .opt-letter {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-faint);
    flex-shrink: 0;
    width: 18px;
  }

  .q-option.selected .opt-letter { color: var(--accent); }
  .q-option.correct .opt-letter { color: var(--accent3); }
  .q-option.incorrect .opt-letter { color: var(--danger); }

  .q-explanation {
    margin-top: 16px;
    padding: 16px;
    background: rgba(0,212,255,0.04);
    border: 1px solid rgba(0,212,255,0.15);
    border-radius: 8px;
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.7;
    display: none;
  }

  .q-explanation.visible { display: block; }
  .q-explanation strong { color: var(--accent); }

  .q-submit {
    background: var(--accent);
    border: none;
    color: #000;
    font-family: var(--body);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
    cursor: pointer;
    margin-top: 16px;
    transition: all 0.2s;
    display: none;
  }

  .q-submit.visible { display: block; }
  .q-submit:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,212,255,0.3); }

  /* RESULTS */
  .results-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 48px;
    text-align: center;
    margin-bottom: 24px;
  }

  .results-score {
    font-family: var(--mono);
    font-size: 80px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
  }

  .results-score.pass { color: var(--accent3); }
  .results-score.fail { color: var(--danger); }

  .results-label {
    font-family: var(--sans);
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .results-sub { color: var(--text-dim); font-size: 15px; }

  .results-breakdown {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 32px 0;
    text-align: left;
  }

  .breakdown-item {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
  }

  .breakdown-label { font-size: 12px; color: var(--text-dim); margin-bottom: 8px; }
  .breakdown-val { font-family: var(--mono); font-size: 28px; font-weight: 700; color: var(--text); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface2);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    padding: 12px 24px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .btn:hover { border-color: var(--accent); color: var(--accent); }
  .btn-primary { background: var(--accent); color: #000; border-color: var(--accent); font-weight: 600; }
  .btn-primary:hover { color: #000; box-shadow: 0 4px 16px rgba(0,212,255,0.3); }

  /* MEMORY AIDS PAGE */
  .memory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .memory-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
  }

  .memory-card h3 {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--accent);
  }

  .mnem-item {
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .mnem-item:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }

  .mnem-acronym {
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 700;
    color: var(--accent3);
    margin-bottom: 4px;
  }

  .mnem-expand {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .mnem-expand b { color: var(--accent3); }

  /* CHEAT SHEET */
  .cheat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .cheat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
  }

  .cheat-card h4 {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .cheat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 0;
    font-size: 13px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .cheat-key { color: var(--text-dim); }
  .cheat-val { font-family: var(--mono); font-size: 12px; color: var(--accent3); font-weight: 700; }

  /* EXAM COMPLETE */
  .restart-btn {
    background: var(--accent2);
    border: none;
    color: white;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 28px;
    border-radius: 8px;
    cursor: pointer;
    margin: 0 8px;
    transition: all 0.2s;
  }

  .restart-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(124,58,237,0.3); }

  /* DOMAIN TAGS */
  .domain-badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .dom-mobile { background: rgba(0,212,255,0.1); color: var(--accent); }
  .dom-network { background: rgba(124,58,237,0.1); color: #a78bfa; }
  .dom-hardware { background: rgba(16,185,129,0.1); color: var(--accent3); }
  .dom-virtualization { background: rgba(245,158,11,0.1); color: var(--warn); }
  .dom-security { background: rgba(239,68,68,0.1); color: #f87171; }
  .dom-software { background: rgba(0,212,255,0.1); color: var(--accent); }
  .dom-troubleshoot { background: rgba(16,185,129,0.1); color: var(--accent3); }
  .dom-operational { background: rgba(245,158,11,0.1); color: var(--warn); }

  /* LISTS */
  .content-card ul, .content-card ol {
    padding-left: 20px;
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.9;
  }

  .content-card li { margin-bottom: 4px; }
  .content-card li strong { color: var(--text); }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .guide-grid { grid-template-columns: 1fr; }
    .guide-sidebar { position: static; max-height: none; }
    .exam-selector { grid-template-columns: 1fr; }
    .results-breakdown { grid-template-columns: 1fr; }
    .hero h1 { font-size: 32px; }
    .main { padding: 20px 16px; }
    .content-card { padding: 20px; }
  }

  /* ANIMATIONS */
  @keyframes fadeIn {
